<?xml version="1.0" encoding="UTF-8"?>
<!--
  Buildyard's Maven loggers. Each module wraps one runtime's own SLF4J logger: the console
  stays exactly as it is, and every log call is also written as one JSON line to the file
  named by -Dbuildyard.log. Buildyard puts a module's classes in a generated
  ${maven.conf}/logging folder, which Maven loads before its own jars. Build with `make ext`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.buildyard</groupId>
  <artifactId>buildyard-maven-log</artifactId>
  <version>1</version>
  <packaging>pom</packaging>

  <modules>
    <module>maven3</module>
    <module>maven4</module>
    <module>mvnd1-stubs</module>
    <module>mvnd1</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible jars: the same sources give the same bytes. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs><arg>-Xlint:-options</arg></compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</version>
          <configuration><skip>true</skip></configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- JsonSink is shared: every runtime module compiles it in. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${maven.multiModuleProjectDirectory}/shared/src/main/java</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
