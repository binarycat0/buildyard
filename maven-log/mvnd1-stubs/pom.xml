<?xml version="1.0" encoding="UTF-8"?>
<!--
  Compile-only stand-ins for the mvnd 1.x logging classes the mvnd1 module extends
  (mvnd-logging is not published to Maven Central). Never shipped.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.buildyard</groupId>
    <artifactId>buildyard-maven-log</artifactId>
    <version>1</version>
  </parent>
  <artifactId>buildyard-maven-log-mvnd1-stubs</artifactId>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-sources</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
